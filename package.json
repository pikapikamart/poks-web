{
  "name": "@pox/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "jobs": "npx trigger.dev@4 dev --env-file .env.local",
    "lint": "eslint .",
    "format": "prettier --write . && eslint . --fix",
    "format:check": "eslint .",
    "supabase:link": "supabase link",
    "supabase:migration": "supabase migration new",
    "supabase:pull": "supabase db pull --linked",
    "supabase:dump": "supabase db dump --linked --file supabase/schema.sql",
    "supabase:push": "supabase db push --linked",
    "supabase:push:dry": "supabase db push --linked --dry-run",
    "supabase:gentypes": "supabase gen types --linked --schema public > src/database/types/index.ts",
    "supabase:status": "supabase migration list --linked"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "@trigger.dev/sdk": "^4.0.0",
    "luxon": "^3.7.2",
    "next": "^16.0.0",
    "openai": "^6.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "supabase": "2.116.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "eslint": "^9.39.5",
    "prettier": "^3.9.8"
  },
  "overrides": {
    "ws@^8.0.0": "8.21.3"
  }
}
